# fusion-model-hub environment template — copy to .env and fill in.
# No real credentials in this file (DB-4). All values optional; unset = SQLite
# + local-fs dev defaults.

# --- Shared data plane (architecture/fusion-db-conventions-1030.md) ---
# One PostgreSQL instance, one database per app (DB-2). Env-only (DB-3).
# First run: create the database once (idempotent, DB-9):
#   createdb fusion_model_hub
#   # or: psql -d postgres -c 'CREATE DATABASE fusion_model_hub'
# Then the server creates/verifies its schema automatically on startup
# (SQLAlchemy create_all — no migration step needed for a fresh database).
# DATABASE_URL=postgresql://127.0.0.1:5432/fusion_model_hub

# Shared Redis instance, per-app logical DB (DB-7). Hub uses /1. Accepted on
# the native plane; reserved (no consumer yet — the rate limiter is
# node-local in-memory by design).
# REDIS_URL=redis://127.0.0.1:6379/1

# --- Service ---
# FMH_DATA_DIR=./data
# MODEL_HUB_AUTH_ENABLED=true

# --- Fusion-MLX / gateway ---
# FMH_MLX_URL=http://127.0.0.1:11432
# FMH_MLX_TOOL_URL=http://127.0.0.1:11434
# FUSION_CLIENT_KEY=

# --- Production secrets (see docs/secret-rotation-runbook.md) ---
# FMH_API_KEY_PEPPER=
# FMH_AUTH_BOOTSTRAP_TOKEN=
